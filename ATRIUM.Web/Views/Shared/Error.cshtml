@using ATRIUM.Web.ViewModels
@model ErrorViewModel
@{
    ViewData["Title"] = "Ocurrió un error";
}

<section class="v-section">
    <div class="v-container">
        <div class="v-empty">
            <span class="eyebrow">ATRIUM · Error</span>
            <h1>No pudimos completar esta acción.</h1>
            <p class="text-muted-v">Inténtalo nuevamente. Si el problema continúa, vuelve al inicio o contacta al soporte de ATRIUM.</p>
            @if (Model.ShowRequestId)
            {
                <p class="text-muted-v"><small>Referencia: <code>@Model.RequestId</code></small></p>
            }
            <div class="v-actions">
                <a class="v-btn v-btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
                <a class="v-btn" asp-controller="Home" asp-action="Contacto">Contactar soporte</a>
            </div>
        </div>
    </div>
</section>
