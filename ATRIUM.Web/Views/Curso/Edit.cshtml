@model ATRIUM.Web.ViewModels.CursoViewModel

@{
    ViewData["Title"] = "Editar curso";
    Layout = "_AdminLayout";
}

<div class="page-head">
    <div>
        <span class="eyebrow">Academia</span>
        <h1>Editar curso</h1>
    </div>
    <a class="v-btn" asp-action="Index">Volver</a>
</div>

<div class="surface-panel">
    <form asp-action="Edit"
          asp-route-id="@Model.IdCurso"
          method="post"
          enctype="multipart/form-data">

        <input asp-for="IdCurso" type="hidden" />
        <input asp-for="ImagenActual" type="hidden" />

        <div asp-validation-summary="ModelOnly"></div>

        <partial name="_CursoForm" model="Model" />

        <button class="v-btn v-btn-primary" type="submit">
            Guardar cambios
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
