@model IEnumerable<ATRIUM.Domain.Models.Curso>
@{ ViewData["Title"] = "Cursos"; Layout = "_AdminLayout"; }
<div class="page-head">
    <div>
        <span class="eyebrow">Academia</span>
        <h1>Cursos</h1>
    </div>
    <a class="v-btn v-btn-primary" asp-action="Create">Nuevo curso</a>
</div>
<div class="v-table-wrap">
    <table class="v-table">
        <thead>
            <tr>
                <th>Curso</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Docente</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>
                        <div class="v-actions">
                            @if(!string.IsNullOrWhiteSpace(item.URLImagen))
                            {
                                <img class="v-img-thumb" src="@item.URLImagen" alt="" loading="lazy" decoding="async" />}<strong>@item.Nombre</strong>
                            </div>
                        </td>
                        <td>@item.Categoria?.Nombre</td>
                        <td>S/ @item.PrecioFinal.ToString("0.00")</td>
                        <td>@item.DocenteAsignado</td>
                        <td>
                            <div class="v-actions">
                                <a class="v-btn" asp-action="Edit" asp-route-id="@item.IdCurso">Editar</a>
                                <a class="v-btn" asp-controller="ModuloCurso" asp-action="Index" asp-route-cursoId="@item.IdCurso">Módulos</a>
                                <a class="v-btn v-btn-danger" asp-action="Delete" asp-route-id="@item.IdCurso">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                    }</tbody>
                </table>
            </div>
