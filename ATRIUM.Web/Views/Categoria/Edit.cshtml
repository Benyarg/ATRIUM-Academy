@model ATRIUM.Domain.Models.Categoria
@{ ViewData["Title"]="Editar categoría"; Layout="_AdminLayout"; }
<div class="page-head">
    <div>
        <span class="eyebrow">Academia</span>
        <h1>Editar categoría</h1>
    </div>
    <a class="v-btn" asp-action="Index">Volver</a>
</div>
<div class="surface-panel">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden"/>
        <partial name="_Form" model="Model"/>
        <button class="v-btn v-btn-primary" type="submit">Guardar</button>
    </form>
</div>
