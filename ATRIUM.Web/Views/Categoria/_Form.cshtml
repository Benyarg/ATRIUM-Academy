@model ATRIUM.Domain.Models.Categoria
<div class="v-form-grid">
    <div class="v-field v-form-full">
        <label class="v-label" asp-for="Nombre">
        </label>
        <input class="v-input" asp-for="Nombre"/>
        <span asp-validation-for="Nombre">
        </span>
    </div>
    <div class="v-field v-form-full">
        <label class="v-label" asp-for="Descripcion">
        </label>
        <textarea class="v-textarea" rows="4" asp-for="Descripcion">
        </textarea>
        <span asp-validation-for="Descripcion">
        </span>
    </div>
    <div class="v-field v-form-full">
        <label>
            <input asp-for="Estado"/> Categoría activa</label>
        </div>
    </div>
