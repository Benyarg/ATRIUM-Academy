@model ATRIUM.Domain.Models.Categoria

@{
    ViewData["Title"] = "Nueva categoría";
    Layout = "_AdminLayout";
}

<div class="page-head">
    <div>
        <span class="eyebrow">Academia</span>
        <h1>Nueva categoría</h1>
    </div>
    <a class="v-btn" asp-action="Index">Volver</a>
</div>

<div class="surface-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly"></div>

        <partial name="_Form" model="Model" />

        <button class="v-btn v-btn-primary" type="submit">
            Crear categoría
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
