@model IEnumerable<ATRIUM.Domain.Models.Certificado>
@{ ViewData["Title"]="Certificados"; Layout=User.IsInRole(AppRoles.Administrator)?"_AdminLayout":"_Layout"; }
@if(User.IsInRole(AppRoles.Administrator))
{
    <div class="page-head">
        <div>
            <span class="eyebrow">Academia</span>
            <h1>Certificados</h1>
        </div>
        <a class="v-btn v-btn-primary" asp-action="Create">Nuevo certificado</a>
    </div>
    <partial name="_CertTable" model="Model"/>}
    else
    {
        <section class="v-section">
            <div class="v-container">
                <div class="page-head">
                    <div>
                        <span class="eyebrow">Logros</span>
                        <h1>Mis certificados</h1>
                    </div>
                    <a class="v-btn" asp-action="Validar">Validar código</a>
                </div>
                <partial name="_CertTable" model="Model"/>
            </div>
        </section>
    }
