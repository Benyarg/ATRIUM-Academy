@model ATRIUM.Domain.Models.Carousel
<div class="v-form-grid">
    <div class="v-field v-form-full">
        <label class="v-label" asp-for="Titulo">
        </label>
        <input class="v-input" asp-for="Titulo"/>
    </div>
    <div class="v-field v-form-full">
        <label class="v-label" asp-for="Descripcion">
        </label>
        <textarea class="v-textarea" rows="4" asp-for="Descripcion">
        </textarea>
    </div>
    <div class="v-field">
        <label class="v-label" asp-for="Orden">
        </label>
        <input class="v-input" asp-for="Orden" type="number"/>
    </div>
    <div class="v-field">
        <label>
            <input asp-for="Activo"/> Banner activo</label>
        </div>
    </div>
