@model ATRIUM.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060607" />
    <title>Crear cuenta - ATRIUM Academy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/img/ATRIUM-FAVICON.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base/typography.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">
<main class="auth-page">
    <section class="auth-visual">
        <a asp-controller="Home" asp-action="Index" aria-label="ATRIUM Academy - Inicio">
            <img class="auth-visual-logo" src="~/img/ATRIUM-ACADEMY-LOCKUP.webp" alt="ATRIUM Academy" />
        </a>
        <div class="auth-copy">
            <span class="eyebrow">Arquitectura · Diseño · Formación</span>
            <h2>Tu próximo<br />proyecto empieza<br />aquí.</h2>
            <p class="lead-v">Crea una cuenta para acceder a cursos, recursos, seguimiento y certificación dentro de una experiencia diseñada para aprender haciendo.</p>
        </div>
    </section>

    <section class="auth-panel">
        <div class="auth-box">
            <img class="auth-brand-mobile" src="~/img/ATRIUM-ACADEMY-LOCKUP.webp" alt="ATRIUM Academy" />
            <a class="auth-back" asp-controller="Home" asp-action="Index">← Volver al inicio</a>
            <span class="eyebrow">Nueva cuenta</span>
            <h1 class="auth-title">Empieza en ATRIUM.</h1>
            <p class="auth-sub">Completa tus datos para organizar tu aprendizaje desde una sola cuenta.</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <div class="auth-grid">
                    <div class="v-field">
                        <label asp-for="Nombre" class="v-label">Nombres</label>
                        <input asp-for="Nombre" class="v-input" autocomplete="given-name" placeholder="Tus nombres" />
                        <span asp-validation-for="Nombre" class="field-validation-error"></span>
                    </div>
                    <div class="v-field">
                        <label asp-for="Apellido" class="v-label">Apellidos</label>
                        <input asp-for="Apellido" class="v-input" autocomplete="family-name" placeholder="Tus apellidos" />
                        <span asp-validation-for="Apellido" class="field-validation-error"></span>
                    </div>
                    <div class="v-field auth-full">
                        <label asp-for="Email" class="v-label">Correo electrónico</label>
                        <input asp-for="Email" class="v-input" type="email" autocomplete="email" placeholder="nombre@correo.com" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>
                    <div class="v-field auth-full">
                        <label asp-for="Direccion" class="v-label">Dirección</label>
                        <input asp-for="Direccion" class="v-input" autocomplete="street-address" placeholder="Tu dirección" />
                        <span asp-validation-for="Direccion" class="field-validation-error"></span>
                    </div>
                    <div class="v-field">
                        <label asp-for="Telefono" class="v-label">Teléfono</label>
                        <input asp-for="Telefono" class="v-input" type="tel" autocomplete="tel" placeholder="+51 999 999 999" />
                        <span asp-validation-for="Telefono" class="field-validation-error"></span>
                    </div>
                    <div class="v-field">
                        <label asp-for="FechaDeNacimiento" class="v-label">Fecha de nacimiento</label>
                        <input asp-for="FechaDeNacimiento" class="v-input" type="date" autocomplete="bday" />
                        <span asp-validation-for="FechaDeNacimiento" class="field-validation-error"></span>
                    </div>
                    <div class="v-field">
                        <label asp-for="Password" class="v-label">Contraseña</label>
                        <div class="password-wrap">
                            <input asp-for="Password" id="registerPassword" class="v-input" type="password" autocomplete="new-password" placeholder="Crea una contraseña" />
                            <button class="password-toggle" type="button" data-password-toggle="registerPassword" aria-label="Mostrar contraseña">Ver</button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>
                    <div class="v-field">
                        <label asp-for="ConfirmPassword" class="v-label">Confirmar contraseña</label>
                        <div class="password-wrap">
                            <input asp-for="ConfirmPassword" id="confirmPassword" class="v-input" type="password" autocomplete="new-password" placeholder="Repite tu contraseña" />
                            <button class="password-toggle" type="button" data-password-toggle="confirmPassword" aria-label="Mostrar contraseña">Ver</button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>
                </div>
                <button class="v-btn v-btn-primary v-btn-lg" type="submit">Crear mi cuenta <span>↗</span></button>
                <div class="auth-rule"></div>
                <div class="auth-foot">¿Ya tienes cuenta? <a asp-action="Login">Iniciar sesión</a></div>
                <div class="auth-foot auth-descriptor">ATRIUM Academy · Arquitectura · Diseño · Formación</div>
            </form>
        </div>
    </section>
</main>
<script src="~/js/auth.js" asp-append-version="true"></script>
<partial name="_ValidationScriptsPartial" />
</body>
</html>
