@model ATRIUM.Web.ViewModels.PerfilViewModel
@{ ViewData["Title"] = "Mi perfil"; }

<section class="student-intro">
    <div class="v-container">
        <div class="page-head">
            <div><span class="eyebrow">Cuenta</span><h1>Mi perfil</h1><p class="lead-v">Mantén actualizada la información asociada a tu cuenta ATRIUM.</p></div>
        </div>
    </div>
</section>

<section class="v-section v-section-compact">
    <div class="v-container profile-shell">
        <aside class="profile-aside">
            <div class="profile-monogram">A</div>
            <span class="eyebrow">ATRIUM Academy</span>
            <h2>Tu identidad dentro de la plataforma.</h2>
            <p class="text-muted-v">Estos datos se utilizan para tu cuenta, pedidos y certificados asociados.</p>
        </aside>
        <div class="surface-panel">
            <form asp-action="Perfil" method="post">
                <div asp-validation-summary="ModelOnly"></div>
                <div class="v-form-grid">
                    <div class="v-field"><label class="v-label" asp-for="Nombre"></label><input class="v-input" asp-for="Nombre" /></div>
                    <div class="v-field"><label class="v-label" asp-for="Apellido"></label><input class="v-input" asp-for="Apellido" /></div>
                    <div class="v-field v-form-full"><label class="v-label" asp-for="Email"></label><input class="v-input" asp-for="Email" /></div>
                    <div class="v-field v-form-full"><label class="v-label" asp-for="Direccion"></label><input class="v-input" asp-for="Direccion" /></div>
                    <div class="v-field"><label class="v-label" asp-for="Telefono"></label><input class="v-input" asp-for="Telefono" /></div>
                    <div class="v-field"><label class="v-label" asp-for="FechaDeNacimiento"></label><input class="v-input" asp-for="FechaDeNacimiento" type="date" /></div>
                </div>
                <button class="v-btn v-btn-primary" type="submit">Guardar cambios</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
