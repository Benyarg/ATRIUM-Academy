@model IEnumerable<ATRIUM.Domain.Models.ModuloCurso>
@{ ViewData["Title"]="Módulos"; Layout="_AdminLayout"; }
<div class="page-head">
    <div>
        <span class="eyebrow">Academia</span>
        <h1>Módulos</h1>
    </div>
    <a class="v-btn v-btn-primary" asp-action="Create">Nuevo módulo</a>
</div>
<div class="v-table-wrap">
    <table class="v-table">
        <thead>
            <tr>
                <th>Curso</th>
                <th>Orden</th>
                <th>Módulo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var x in Model)
            {
                <tr>
                    <td>@x.Curso?.Nombre</td>
                    <td>@x.Orden</td>
                    <td>
                        <strong>@x.Titulo</strong>
                    </td>
                    <td>
                        <div class="v-actions">
                            <a class="v-btn" asp-action="Edit" asp-route-id="@x.IdModulo">Editar</a>
                            <a class="v-btn" asp-controller="ContenidoModulo" asp-action="Index" asp-route-moduloId="@x.IdModulo">Lecciones</a>
                            <a class="v-btn v-btn-danger" asp-action="Delete" asp-route-id="@x.IdModulo">Eliminar</a>
                        </div>
                    </td>
                </tr>
                }</tbody>
            </table>
        </div>
