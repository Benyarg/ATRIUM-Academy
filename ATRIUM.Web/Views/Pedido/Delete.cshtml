@model ATRIUM.Domain.Models.Pedido
@{ ViewData["Title"]="Eliminar pedido"; Layout="_AdminLayout"; }
<div class="page-head">
    <div>
        <span class="eyebrow">Confirmación</span>
        <h1>Eliminar pedido #@Model.IdPedido</h1>
    </div>
</div>
<div class="surface-panel">
    <form asp-action="Delete" asp-route-id="@Model.IdPedido" method="post">
        <button class="v-btn v-btn-danger" type="submit" data-confirm="¿Eliminar este pedido?">Eliminar</button>
        <a class="v-btn" asp-action="Index">Cancelar</a>
    </form>
</div>
